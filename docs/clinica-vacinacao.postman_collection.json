{
  "info": {
    "name": "Clínica de Vacinação",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3333" },
    { "key": "access_token", "value": "" },
    { "key": "refresh_token", "value": "" },
    { "key": "vacina_id", "value": "" },
    { "key": "insumo_id", "value": "" },
    { "key": "fabricante_id", "value": "" },
    { "key": "lote_id", "value": "" },
    { "key": "cliente_id", "value": "" },
    { "key": "agendamento_id", "value": "" }
  ],
  "item": [
    {
      "name": "1. Autenticação",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.accessToken) {",
                  "  pm.collectionVariables.set('access_token', data.accessToken);",
                  "  pm.collectionVariables.set('refresh_token', data.refreshToken);",
                  "  console.log('Token salvo!');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@clinica.local\",\n  \"senha\": \"TrocarNoPrimeiroAcesso123\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          }
        }
      ]
    }
  ]
}
